# Copy to `.env` (docker compose reads it automatically) or export directly for local dev.
# CONSTITUTION III.7: DEMO_MODE=true works with every other line below left unset. No secret
# below has a default -- a missing one fails loudly at startup, never silently at the first
# model call in front of a judge.

# -- Demo path (no keys needed) ---------------------------------------------------------------

# The full interview -> research -> recommend -> book -> mock-pay flow runs with no live model,
# no database and no credentials. Set this and nothing else to see the whole product.
DEMO_MODE=true

# -- Live path ----------------------------------------------------------------------------------

# Required only when DEMO_MODE is not "true". Powers the orchestrator, critic and explainer
# roles (src/agent/subagents.py) via the Claude Agent SDK.
# ANTHROPIC_API_KEY=

# Model routing. PLAN-00 §6.7 specifies claude-opus-5 / effort=high / adaptive thinking for the
# orchestrator tier -- correct for a funded deployment, expensive and slow for development
# against a metered key (measured: ~72s for one INTERVIEW turn, two serialised Opus calls).
# These three default to the cheap, fast routing so nobody burns a budget by forgetting to set
# them; uncomment all three for the plan's routing.
# CARDINAL_AGENT_MODEL=claude-opus-5
# CARDINAL_AGENT_EFFORT=high
# CARDINAL_AGENT_THINKING=adaptive

# -- Alternate INTERVIEW-phase models (D-056/D-059, optional) ---------------------------------

# Which model asks the interview questions. Defaults to groq/qwen/qwen3.6-27b (D-059); set it to
# "claude" to put the whole session on the Claude Agent SDK from the first turn, which is what
# every phase gate assumes. An id this catalog doesn't carry falls back to "claude" rather than
# 502-ing every first turn.
# CARDINAL_INTERVIEW_MODEL=groq/qwen/qwen3.6-27b

# Restores D-056's developer model picker in the chat rail. Off by default: GET /models serves an
# empty list, so no third-party model name reaches the browser. Which model runs the interview is
# an implementation detail -- RESEARCH/RECOMMEND/TRANSACT are Claude's either way.
# CARDINAL_SHOW_MODEL_PICKER=false

# Only read if a session runs on a non-Claude model, whether by the default above or by an
# explicit POST /sessions/{id}/model (src/agent/providers.py). Scoped to the interview only:
# RESEARCH/RECOMMEND/TRANSACT always run through Claude regardless of what is set here.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# -- Voice (optional, PLAN-02 P16) --------------------------------------------------------------

# Voice is a three-tier cascade, chosen per call, never per session:
#
#   tier 1  ElevenLabs (speech out) + Groq Whisper (speech in)   <- keys below
#   tier 2  the browser's own Web Speech API                     <- no keys, always available
#   tier 3  plain text                                           <- no mic permission
#
# All unset -> tier 2 serves every utterance and the whole voice feature still works. That is
# what keeps CONSTITUTION III.7 true: `DEMO_MODE=true` with nothing else set runs the complete
# flow, voice included. Set these for the recorded demo -- tier 1 is the version worth showing.
# A quota that empties mid-session drops to tier 2 on the next utterance with no reload.
#
# Pull fresh keys from each provider's own dashboard. Do NOT paste values from another project:
# secrets stay scoped per repo, and a key copied between two of them leaks both at once.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Speech-to-text. GROQ_API_KEY is tier 1's first choice (free tier serves
# whisper-large-v3-turbo); OPENAI_API_KEY is the paid fallback *within* tier 1, tried before
# the cascade drops to the browser at all. Both are also read by the INTERVIEW-phase model
# router above -- one key, two uses, no second variable.

# -- Storage --------------------------------------------------------------------------------------

# Postgres connection string (src/adapters/db/session.py). Unset -> the API serves the
# generated 240-listing catalogue straight from memory instead of failing to boot -- this is
# what makes `make test`/`make dev` work with no container at all. `docker compose up` sets
# this itself (see docker-compose.yml's `api` service); only needed here for a local, non-
# Docker Postgres.
# CARDINAL_DATABASE_URL=postgresql+psycopg://cardinal:cardinal@localhost:5432/cardinal

# booking-mcp's standalone HTTP transport (PHASE-2/PHASE-11 SS3). Unset -> the API process
# spawns and owns a local `python -m src.mcp.booking.http` subprocess on 127.0.0.1:8100 itself
# (local dev, every gate through P10). `docker compose up` sets this to the `booking` service's
# own compose hostname, since PHASE-11 requires booking-mcp to be a genuinely separate service
# on a separate origin, not a subprocess of `api`.
# CARDINAL_BOOKING_MCP_URL=http://booking:8100/mcp

# booking-mcp's own bind address/port (src/mcp/booking/http.py), read only by the process
# running that module directly. Defaults to 127.0.0.1:8100, correct for the local-subprocess
# case above. `docker compose up`'s `booking` service overrides the host to 0.0.0.0 so other
# containers (namely `api`, via CARDINAL_BOOKING_MCP_URL) can reach it -- set in
# docker-compose.yml itself, not needed here unless running that module standalone.
# BOOKING_MCP_HTTP_HOST=127.0.0.1
# BOOKING_MCP_HTTP_PORT=8100

# -- Observability (optional, PHASE-9) -------------------------------------------------------

# All three unset -> tracing runs against an in-memory exporter only (still real spans, still
# what gate 9's evidence is built on) and nothing leaves the process. Set all three to also
# export to Langfuse (cloud.langfuse.com by default, or your own instance via LANGFUSE_HOST --
# DECISIONS.md D-048 on why this repo doesn't self-host a langfuse container).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# -- Local frontend dev only --------------------------------------------------------------------

# Overrides which port web/vite.config.ts's dev-server proxy targets for /health, /sessions,
# /adapters, /mcp-apps and /demo. Defaults to 8000 (make dev's port). Not read by anything
# inside a container -- docker-compose.yml's `web` service talks to `api` by compose hostname
# instead (web/nginx.conf), so this only matters running `npm run dev`/`preview` outside Docker
# against an API on a non-default port (e.g. one of the gate scripts' own disposable backends).
# CARDINAL_API_PORT=8000
